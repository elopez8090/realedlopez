---
interface Props { faqs: { q: string; a: string }[]; heading?: string }
const { faqs, heading = 'Common questions' } = Astro.props;
---

<section class="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">{heading}</h2>
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</section>

<style>
  .faq { margin-top: clamp(3rem, 7vw, 5rem); }
  h2 { font-size: var(--step-2); margin-bottom: 1.25rem; }
  details { border-top: 1px solid var(--rule); }
  details:last-of-type { border-bottom: 1px solid var(--rule); }
  summary {
    cursor: pointer; list-style: none; padding: 1.1rem 2rem 1.1rem 0; position: relative;
    font-weight: 600; font-size: 1.075rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: 0.25rem; top: 50%; transform: translateY(-50%);
    color: var(--amber); font-family: var(--mono); font-size: 1.25rem; transition: transform 0.15s;
  }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  details p { margin: 0 0 1.25rem; color: #c4ccda; max-width: 64ch; }
</style>
