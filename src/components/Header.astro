---
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'How I work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${site.name}, home`}>
      <span class="prompt" aria-hidden="true">~/</span><span class="name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.href === '/blog/' && path.startsWith('/blog') ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 4.5rem; gap: 1rem; }
  .logo { display: inline-flex; align-items: baseline; gap: 0.4rem; text-decoration: none; white-space: nowrap; }
  .name { font-family: var(--sans); font-weight: 600; font-size: 1.375rem; letter-spacing: -0.02em; }
  .prompt { font-family: var(--mono); font-weight: 500; font-size: 1.05rem; }
  .prompt { color: var(--amber); }
  ul { display: flex; gap: clamp(0.9rem, 3vw, 2rem); list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; color: var(--muted); font-size: var(--step--1); font-weight: 500; transition: color 0.15s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  @media (max-width: 30rem) {
    .bar { height: 3.75rem; }
    nav li:nth-child(2) { display: none; }
    ul { gap: 1rem; }
    nav a { font-size: 0.9rem; }
    .name { font-size: 1.15rem; }
    .prompt { display: none; }
  }
  @media (max-width: 23rem) {
    nav li:nth-child(3) { display: none; }
  }
</style>
