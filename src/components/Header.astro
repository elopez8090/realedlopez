---
import { site } from '../data/site';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { getCollection } from 'astro:content';
const hasPosts = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
const path = Astro.url.pathname;
// `wide: true` links are hidden on small phones to keep the menu on one line.
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/#experience', label: 'How I work', wide: true },
  ...(hasPosts ? [{ href: '/blog/', label: 'Notes', wide: true }] : []),
  { href: '/#contact', label: 'Contact' },
];
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${site.name}, home`}>
      <Image src={logo} alt={site.name} width={400} class="logo-img" loading="eager" />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li class={l.wide ? 'wide' : undefined}>
            <a href={l.href} aria-current={(l.href === '/blog/' && path.startsWith('/blog')) || (l.href === '/services/' && path.startsWith('/services')) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 4.5rem; gap: 1rem; }
  .logo { display: inline-flex; align-items: center; text-decoration: none; flex: none; }
  .logo-img { height: 30px; width: auto; display: block; }
  ul { display: flex; gap: clamp(0.9rem, 3vw, 2rem); list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; color: var(--muted); font-size: var(--step--1); font-weight: 500; transition: color 0.15s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  @media (max-width: 40rem) {
    .bar { height: 3.75rem; }
    nav li.wide { display: none; }
    ul { gap: 1rem; }
    nav a { font-size: 0.9rem; }
    .logo-img { height: 22px; }
  }
</style>
