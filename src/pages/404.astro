---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Page not found | ${site.name}`} description="This page doesn't exist. Head back to the homepage to find what you need." noindex>
  <section class="wrap nf">
    <p class="cmd"><span>$</span> cd {Astro.url.pathname}</p>
    <p class="err">No such file or directory</p>
    <h1>This page doesn’t exist.</h1>
    <p class="hint">The link may be old or mistyped. Head back to the homepage to find what you need.</p>
    <a class="btn btn-primary" href="/">Go to homepage</a>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(5rem, 14vw, 10rem); }
  .cmd, .err { font-family: var(--mono); font-size: 0.9rem; margin: 0; }
  .cmd span { color: var(--amber); }
  .err { color: var(--muted); margin-bottom: 2rem; }
  h1 { font-size: var(--step-3); }
  .hint { color: var(--muted); max-width: 42ch; margin: 1rem 0 2rem; }
</style>
