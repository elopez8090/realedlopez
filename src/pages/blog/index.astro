---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={`Writing | ${site.name}`} description={`Articles by ${site.name} on building, shipping, and running software.`}>
  <section class="wrap page">
    <h1>Writing</h1>
    <p class="sub">Notes on building, shipping, and running software in production.</p>

    {posts.length === 0 ? (
      <p class="empty">The first posts are on the way. In the meantime, <a href="/#work">see my work</a>.</p>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="t">{p.data.title}</span>
              <span class="d">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .page { padding-block: clamp(3.5rem, 8vw, 6rem); }
  h1 { font-size: var(--step-4); }
  .sub { color: var(--muted); font-size: var(--step-1); margin: 1rem 0 3rem; max-width: 40ch; }
  .empty { color: var(--muted); }
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts a {
    display: grid; grid-template-columns: 9rem 1fr; gap: 0.25rem 2rem;
    padding-block: 1.5rem; border-top: 1px solid var(--rule); text-decoration: none;
  }
  .posts li:last-child a { border-bottom: 1px solid var(--rule); }
  time { grid-row: span 2; color: var(--muted); font-family: var(--mono); font-size: 0.8rem; padding-top: 0.3rem; }
  .t { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.015em; transition: color 0.15s; }
  .posts a:hover .t { color: var(--amber); }
  .d { color: var(--muted); }
  @media (max-width: 36rem) {
    .posts a { grid-template-columns: 1fr; }
    time { grid-row: auto; padding: 0; }
  }
</style>
